#ifndef SECRETS_H
#define SECRETS_H

// ==================== WiFi配置 ====================
#define WIFI_SSID "your_wifi_ssid"
#define WIFI_PASSWORD "your_wifi_password"

// ==================== 华为云IoTDA配置 ====================
#define DEVICE_ID "your_device_id"  // 设备ID

// MQTT连接参数（手动配置）
#define MQTT_SERVER   "your_iotda_endpoint.iot-mqtts.cn-north-4.myhuaweicloud.com"  // IoTDA接入地址
#define MQTT_PORT     1883  // MQTT端口（非加密1883，加密8883）
#define CLIENT_ID     "your_device_id_0_0_2026042001"  // Client ID格式: {DeviceId}_0_0_{Timestamp}
#define MQTT_USER     "your_device_id"  // MQTT用户名等于设备ID
#define MQTT_PASSWORD "your_mqtt_password_hash"  // MQTT密码为设备密钥哈希

// MQTT主题定义（使用宏定义，避免字符串拼接）
#define MQTT_TOPIC_REPORT       "$oc/devices/" DEVICE_ID "/sys/properties/report"
#define MQTT_TOPIC_COMMANDS     "$oc/devices/" DEVICE_ID "/sys/commands/request/id/+"
#define MQTT_TOPIC_CMD_RESPONSE "$oc/devices/" DEVICE_ID "/sys/commands/response/request_id="

// ==================== 华为云OBS配置 ====================
#define OBS_ACCESS_KEY "your_access_key"
#define OBS_SECRET_KEY "your_secret_key"
#define OBS_ENDPOINT "obs.cn-north-4.myhuaweicloud.com"
#define OBS_BUCKET_NAME "your_bucket_name"
#define OBS_REGION "cn-north-4"  // OBS所在区域

// ==================== AI识别API配置 ====================
// 支持 OpenAI 兼容 API，推荐使用 DashScope 通义千问（兼容模式）
// API地址会自动补齐 /v1/chat/completions 路径
#define AI_API_KEY "your_api_key"
#define AI_API_ENDPOINT "https://dashscope.aliyuncs.com/compatible-mode"
#define AI_MODEL "qwen3.5-flash"

#endif // SECRETS_H
